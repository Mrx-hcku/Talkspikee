name: Build Flutter APK & Get SH1

on:
  push:
    branches: [ "main", "master" ]
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: build-apk-${{ github.ref }}
  cancel-in-progress: false

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout Repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: 'zulu'
          java-version: '17'

      - name: Set up Flutter
        uses: subosito/flutter-action@v2
        with:
          flutter-version: '3.19.2'
          channel: 'stable'
          cache: true

      # ---------------------------------------------------------------
      # Permanent keystore: pehli baar banta hai, repo me commit hota hai
      # (keystore/key.jks). Uske baad har build me wahi use hota hai,
      # isliye SHA-1 kabhi nahi badlega.
      # ---------------------------------------------------------------
      - name: Create / Restore Persistent Keystore
        run: |
          mkdir -p keystore

          if [ ! -f keystore/key.jks ]; then
            if [ -f android/app/key.jks ]; then
              echo "Purana android/app/key.jks migrate kar rahe hain..."
              cp android/app/key.jks keystore/key.jks
            elif [ -f key.jks ]; then
              echo "Purana key.jks migrate kar rahe hain..."
              cp key.jks keystore/key.jks
            else
              echo "Naya permanent keystore ban raha hai (sirf pehli baar)..."
              keytool -genkeypair -v \
                -keystore keystore/key.jks \
                -keyalg RSA -keysize 2048 -validity 36500 \
                -alias key -storepass android123 -keypass android123 \
                -dname "CN=TalkSpike, OU=App, O=TalkSpike, L=Lucknow, ST=Uttar Pradesh, C=IN"
            fi
          fi

          keytool -list -keystore keystore/key.jks -alias key -storepass android123 > /dev/null \
            || { echo "::error::keystore alias 'key' / password 'android123' match nahi kar raha"; exit 1; }

      - name: Commit Keystore Back To Repo (only if new)
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add -f keystore/key.jks
          if git diff --cached --quiet; then
            echo "Keystore already repo me hai."
          else
            git commit -m "Add persistent signing keystore [skip ci]"
            git push origin HEAD:${{ github.ref_name }} \
              || { echo "::error::Keystore push fail hua. Repo Settings > Actions > General > Workflow permissions = Read and write karo."; exit 1; }
          fi

      - name: Recreate Clean Android Platform
        run: |
          GS=""
          for f in android/app/google-services.json android/google-services.json google-services.json; do
            if [ -f "$f" ]; then GS="$f"; break; fi
          done
          if [ -z "$GS" ]; then
            echo "::error::google-services.json repo me nahi mila (android/app/ me rakho)."
            exit 1
          fi
          cp "$GS" "$RUNNER_TEMP/google-services.json"

          rm -rf android
          flutter create . --platforms=android --project-name talkspike --org com.example

          mkdir -p android/app
          cp "$RUNNER_TEMP/google-services.json" android/app/google-services.json
          echo "google-services.json restore ho gaya."

      - name: Patch Android Project (Firebase, Signing, Permissions, Package)
        run: |
          cat > android/key.properties <<EOF
          storePassword=android123
          keyPassword=android123
          keyAlias=key
          storeFile=$GITHUB_WORKSPACE/keystore/key.jks
          EOF

          python3 - <<'PY'
          import json, os, re, sys

          def fail(msg):
              print("ERROR: " + msg)
              sys.exit(1)

          # 1) google-services.json se real package name nikalo
          with open("android/app/google-services.json") as f:
              gs = json.load(f)
          pkg = None
          for c in gs.get("client", []):
              p = c.get("client_info", {}).get("android_client_info", {}).get("package_name")
              if p:
                  pkg = p
                  break
          if not pkg:
              fail("google-services.json me package_name nahi mila")
          print("Package name:", pkg)

          # 2) android/settings.gradle -> google-services plugin declare
          sp = "android/settings.gradle"
          st = open(sp).read()
          if "com.google.gms.google-services" not in st:
              st, n = re.subn(
                  r'(id\s+"com\.android\.application"\s+version\s+"[^"]+"\s+apply\s+false[ \t]*\n)',
                  lambda m: m.group(1) + '    id "com.google.gms.google-services" version "4.3.15" apply false\n',
                  st, count=1)
              if n == 0:
                  fail("settings.gradle me plugins block nahi mila")
              open(sp, "w").write(st)

          # 3) android/app/build.gradle
          bp = "android/app/build.gradle"
          s = open(bp).read()

          s = s.replace("com.example.talkspike", pkg)
          s = re.sub(r'minSdkVersion\s+flutter\.minSdkVersion', 'minSdkVersion 23', s)

          if "com.google.gms.google-services" not in s:
              s, n = re.subn(
                  r'(id\s+"dev\.flutter\.flutter-gradle-plugin"[ \t]*\n)',
                  lambda m: m.group(1) + '    id "com.google.gms.google-services"\n',
                  s, count=1)
              if n == 0:
                  fail("app/build.gradle me plugins block nahi mila")

          signing_block = (
              "\n    signingConfigs {\n"
              "        release {\n"
              "            keyAlias keystoreProperties[\"keyAlias\"]\n"
              "            keyPassword keystoreProperties[\"keyPassword\"]\n"
              "            storeFile keystoreProperties[\"storeFile\"] ? file(keystoreProperties[\"storeFile\"]) : null\n"
              "            storePassword keystoreProperties[\"storePassword\"]\n"
              "        }\n"
              "    }\n"
          )
          keystore_code = (
              "def keystoreProperties = new Properties()\n"
              "def keystorePropertiesFile = rootProject.file(\"key.properties\")\n"
              "if (keystorePropertiesFile.exists()) {\n"
              "    keystorePropertiesFile.withReader(\"UTF-8\") { reader -> keystoreProperties.load(reader) }\n"
              "}\n\n"
          )

          s, n = re.subn(r'^android\s*\{[ \t]*\n',
                         lambda m: keystore_code + "android {" + signing_block + "\n",
                         s, count=1, flags=re.M)
          if n == 0:
              fail("app/build.gradle me android { block nahi mila")

          # release build ko debug key se nahi, apni permanent key se sign karo
          s, n = re.subn(
              r'signingConfig\s+signingConfigs\.debug',
              'signingConfig signingConfigs.release\n'
              '            minifyEnabled false\n'
              '            shrinkResources false',
              s, count=1)
          if n == 0:
              fail("release signingConfig line nahi mili")

          open(bp, "w").write(s)

          # 4) MainActivity ko sahi package me lao (warna app open hote hi crash/blank)
          base = "android/app/src/main/kotlin"
          src = None
          for root, _, files in os.walk(base):
              if "MainActivity.kt" in files:
                  src = os.path.join(root, "MainActivity.kt")
                  break
          if not src:
              fail("MainActivity.kt nahi mila")
          code = open(src).read()
          code = re.sub(r'^package\s+[\w.]+', "package " + pkg, code, count=1, flags=re.M)
          dest_dir = os.path.join(base, *pkg.split("."))
          os.makedirs(dest_dir, exist_ok=True)
          dest = os.path.join(dest_dir, "MainActivity.kt")
          if os.path.abspath(src) != os.path.abspath(dest):
              os.remove(src)
          open(dest, "w").write(code)
          for root, dirs, files in os.walk(base, topdown=False):
              if root != base and not os.listdir(root):
                  os.rmdir(root)

          # 5) Manifest: INTERNET (release me default nahi hota!), notifications, app name
          mp = "android/app/src/main/AndroidManifest.xml"
          m = open(mp).read()
          for perm in ["android.permission.INTERNET", "android.permission.POST_NOTIFICATIONS"]:
              if perm not in m:
                  m = m.replace("<application",
                                '<uses-permission android:name="%s"/>\n    <application' % perm, 1)
          m = re.sub(r'android:label="[^"]*"', 'android:label="TalkSpike"', m, count=1)
          open(mp, "w").write(m)

          print("Android project patched OK")
          PY

          echo "---- app/build.gradle ----"
          cat android/app/build.gradle
          echo "---- settings.gradle ----"
          cat android/settings.gradle

      - name: Grant Execute Permission for Gradlew
        run: chmod +x android/gradlew

      - name: Install Dependencies
        run: flutter pub get

      - name: Build APK (Release)
        run: flutter build apk --release

      - name: Print SHA-1 & SHA-256 (hamesha same rahega)
        run: |
          keytool -list -v -keystore keystore/key.jks -alias key -storepass android123 \
            | grep -E "SHA1:|SHA256:" | sed 's/^ *//' | tee sha.txt
          {
            echo "### Signing certificate (har build me same)"
            echo '```'
            cat sha.txt
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"

      - name: Upload APK Artifact
        uses: actions/upload-artifact@v4
        with:
          name: release-apk
          path: |
            build/app/outputs/flutter-apk/app-release.apk
            sha.txt
